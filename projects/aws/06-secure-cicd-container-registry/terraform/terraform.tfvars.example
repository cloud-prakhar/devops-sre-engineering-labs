aws_region                  = "us-east-1"
owner                       = "your-name"
github_repository           = "your-github-user/devops-sre-engineering-labs" # your fork
github_environment          = "aws-06-lab"
create_github_oidc_provider = true # false if the account already has token.actions.githubusercontent.com
allowed_ssh_cidrs           = ["203.0.113.10/32"]
allowed_http_cidrs          = ["203.0.113.10/32"]
ssh_public_key_path         = "~/.ssh/id_ed25519.pub"
instance_type               = "t3.micro"
