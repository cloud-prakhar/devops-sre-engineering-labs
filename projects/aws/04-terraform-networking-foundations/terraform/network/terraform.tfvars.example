aws_region          = "us-east-1"
owner               = "your-name"
vpc_cidr            = "10.40.0.0/16"
az_count            = 2
nat_mode            = "none" # "instance" = free-tier NAT instance, "gateway" = billed NAT Gateway
enable_test_hosts   = true   # two t3.micro instances for the routing tests
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
allowed_ssh_cidrs   = ["203.0.113.10/32"]
