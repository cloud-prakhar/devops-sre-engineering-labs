# Copied to .env by scripts/deploy.sh (VM) or scripts/local-test.sh (laptop).
APP_VERSION=dev
HTTP_PORT=80
HTTPS_PORT=443
# Subject Alternative Names for the self-signed certificate, e.g. IP:54.1.2.3
TLS_SAN=DNS:localhost,IP:127.0.0.1
# Where the shared Taskboard source lives relative to compose.yaml
TASKBOARD_SRC=../../../../shared/sample-apps/taskboard
