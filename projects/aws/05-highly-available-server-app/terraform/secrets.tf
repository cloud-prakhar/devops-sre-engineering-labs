# The database password is generated by an ephemeral resource and passed only to write-only
# arguments: it exists during the apply but is never written to the Terraform plan or state.
ephemeral "aws_secretsmanager_random_password" "db" {
  password_length     = 32
  exclude_punctuation = true
}

# Instances read the password at boot. SecureString with the AWS-managed aws/ssm key: standard
# parameters and the managed key have no charge.
resource "aws_ssm_parameter" "db_password" {
  name             = local.user_data_vars.db_password_param
  description      = "Taskboard database password (written by Terraform, read by app instances)"
  type             = "SecureString"
  value_wo         = ephemeral.aws_secretsmanager_random_password.db.random_password
  value_wo_version = var.db_password_version
}
