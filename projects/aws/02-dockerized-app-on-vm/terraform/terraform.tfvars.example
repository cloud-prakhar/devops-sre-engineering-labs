aws_region          = "us-east-1"
owner               = "your-name"
instance_type       = "t3.micro"
root_volume_gb      = 20
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
allowed_ssh_cidrs   = ["203.0.113.10/32"] # your IP
allowed_http_cidrs  = []                  # empty = only your IP can reach port 80
