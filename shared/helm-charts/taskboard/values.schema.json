{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "version"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[a-z0-9.:/_-]*$" },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$",
          "description": "Image digest; tags are not accepted"
        }
      },
      "additionalProperties": false
    },
    "version": { "type": "string", "minLength": 1, "maxLength": 63 },
    "replicaCount": { "type": "integer", "minimum": 1, "maximum": 10 },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1, "maximum": 10 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 10, "maximum": 95 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" }, "minAvailable": { "type": "integer", "minimum": 1 } }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "inboundCidrs": { "type": "string", "not": { "pattern": "0\\.0\\.0\\.0/0" } },
        "tags": { "type": "string" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" }, "albSourceCidr": { "type": "string" } }
    }
  }
}
